{
  "name": "coal-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node backen/app.js",
    "server:knowledge": "\".venv\\Scripts\\python.exe\" -m uvicorn backend_fastapi.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:full": "concurrently \"npm run server\" \"npm run server:knowledge\" \"npm run dev\"",
    "test:backend": "\".venv\\Scripts\\python.exe\" -m pytest tests/test_core.py -q",
    "eval:retrieval": "\".venv\\Scripts\\python.exe\" evaluation/evaluate_retrieval.py",
    "eval:generate": "\".venv\\Scripts\\python.exe\" evaluation/generate_questions.py",
    "eval:compare": "\".venv\\Scripts\\python.exe\" evaluation/compare_retrieval.py",
    "audit:index": "\".venv\\Scripts\\python.exe\" -m backend_fastapi.index_tools audit"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "element-plus": "^2.10.2",
    "express": "^4.18.2",
    "openai": "^5.8.2",
    "pinia": "^2.3.1",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^8.2.2",
    "vite": "^6.3.5"
  }
}
